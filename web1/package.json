{
  "name": "capy-web1",
  "version": "1.0.0",
  "description": "Capy legacy web application (v1) runtime and Playwright test suite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "http-server -c-1 . -p 8000",
    "server": "node server.js",
    "test": "node ./scripts/run-tests.js",
    "test:smoke": "playwright test --config=playwright.config.js --project=chromium",
    "setup:playwright": "npx playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.1",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
